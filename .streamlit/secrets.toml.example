# Настройки LLM. Streamlit Cloud: App → Settings → Secrets (вставить текст целиком).
# Локально: скопировать в .streamlit/secrets.toml (файл в .gitignore, не коммитить!).
# app.py передаёт эти ключи в переменные окружения, их читает ai_generator.py.

# --- Основной: Groq, GPT-OSS 120B (бесплатный ключ: https://console.groq.com/keys) ---
# llama-3.3-70b-versatile с 16.08.2026 недоступна на бесплатном тарифе Groq (отвечает ошибкой).
OPENAI_API_KEY = "gsk_..."
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
OPENAI_MODEL = "openai/gpt-oss-120b"
OPENAI_REASONING_EFFORT = "low"

# --- Запасные провайдеры (по порядку, если основной отказал: HTTP 403 / 429 / таймаут) ---
# По правилам хакатона — только open-source модели (ChatGPT, Gemini запрещены).
# 1) Cerebras, та же gpt-oss-120b, Free: 30K токенов/мин, 1M/день (ключ: https://cloud.cerebras.ai):
# FALLBACK_API_KEY = "csk-..."
# FALLBACK_BASE_URL = "https://api.cerebras.ai/v1"
# FALLBACK_MODEL = "gpt-oss-120b"
# FALLBACK_REASONING_EFFORT = "low"
# 2) OpenRouter, открытая qwen3.8-27b, бесплатный канал бывает перегружен (ключ: https://openrouter.ai/settings/keys):
# FALLBACK2_API_KEY = "sk-or-..."
# FALLBACK2_BASE_URL = "https://openrouter.ai/api/v1"
# FALLBACK2_MODEL = "qwen/qwen3.8-27b:free"
# FALLBACK2_REASONING_EFFORT = "none"         # без «размышлений»: ~20 с вместо ~60 с

# --- Финал: стек технологического партнёра (Yandex Cloud AI Studio, OpenAI-совместимый API) ---
# Переключение — только смена этих трёх значений, код не меняется.

# Без ключа сервис работает на встроенном эмуляторе (Ollama в облаке недоступна).
