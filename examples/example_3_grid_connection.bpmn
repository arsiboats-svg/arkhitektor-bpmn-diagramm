  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Технологическое присоединение льготного потребителя (до 15 кВт) к электрическим сетям" processRef="Process_Root" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Root" name="Технологическое присоединение льготного потребителя (до 15 кВт) к электрическим сетям" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Root">
      <bpmn:lane id="Lane_1" name="Заявитель">
        <bpmn:flowNodeRef>Activity_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RootStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RootEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Центр обслуживания клиентов">
        <bpmn:flowNodeRef>Activity_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Отдел технологического присоединения">
        <bpmn:flowNodeRef>Activity_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Эксплуатационная служба">
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_1" name="Подать заявку на технологическое присоединение с пакетом документов и…">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_2" name="Зарегистрировать заявку в информационной системе (1 рабочий день)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_3" name="Проверить комплектность документов и право на льготную категорию">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Документы полные?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Activity_4" name="Подготовка технических условий и договора">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:startEvent id="Event_1" name="Начало">
        <bpmn:outgoing>Flow_25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_2" name="Завершено">
        <bpmn:incoming>Flow_26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="Activity_5" name="Определить точку присоединения и максимальную мощность">
        <bpmn:incoming>Flow_25</bpmn:incoming>
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="Activity_6" name="Рассчитать размер платы по льготному тарифу">
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Activity_7" name="Разработать технические условия">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_8" name="Подготовить проект договора об осуществлении технологического…">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_5" targetRef="Activity_6" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_6" targetRef="Activity_7" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_7" targetRef="Activity_8" />
      <bpmn:sequenceFlow id="Flow_25" sourceRef="Event_1" targetRef="Activity_5" />
      <bpmn:sequenceFlow id="Flow_26" sourceRef="Activity_8" targetRef="Event_2" />
    </bpmn:subProcess>
    <bpmn:userTask id="Activity_9" name="Направить заявителю проект договора и технические условия (1 рабочий…">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_10" name="Подписать договор и внести плату">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_2" name="Договор подписан?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_3" name="Параллельные работы">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_4" name="Работы завершены">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Activity_11" name="Выполнить строительно-монтажные работы до границы участка заявителя">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_12" name="Выполнить мероприятия на своём участке по техническим условиям">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_13" name="Провести осмотр присоединяемых устройств заявителя">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_5" name="Замечаний нет?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_14" name="Подключить объект под напряжение и составить акт о технологическом…">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_15" name="Оформить документы и закрыть заявку (1 рабочий день)">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Event_RootStart" name="Старт процесса">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_RootEnd" name="Процесс завершён">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
