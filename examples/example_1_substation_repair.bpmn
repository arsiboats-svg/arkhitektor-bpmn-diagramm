  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Аварийно-восстановительные работы на ПС 110 кВ с оформлением наряда-допуска" processRef="Process_Root" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Root" name="Аварийно-восстановительные работы на ПС 110 кВ с оформлением наряда-допуска" isExecutable="false">
