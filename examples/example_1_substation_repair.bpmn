        <bpmn:flowNodeRef>Activity_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_1" name="Принять сообщение об аварийном отключении оборудования ПС 110 кВ">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_2" name="Зафиксировать аварию в оперативном журнале автоматизированной системы">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_3" name="Оценить масштаб повреждения и определить зону отключения">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_4" name="Оформить наряд-допуск на аварийные работы">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_5" name="Проверить наряд-допуск, состав бригады и допуски персонала">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Допуск выдан?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Activity_6" name="Комплексная диагностика повреждений">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:startEvent id="Event_1" name="Начало">
        <bpmn:outgoing>Flow_25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_2" name="Завершено">
        <bpmn:incoming>Flow_26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="Activity_7" name="Провести визуальный осмотр ячейки и ошиновки">
        <bpmn:incoming>Flow_25</bpmn:incoming>
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_8" name="Выполнить тепловизионный контроль контактных соединений">
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_9" name="Проверить состояние изоляции и цепей вторичной коммутации">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_10" name="Измерить сопротивление изоляции и параметры защит">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_7" targetRef="Activity_8" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_8" targetRef="Activity_9" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_9" targetRef="Activity_10" />
      <bpmn:sequenceFlow id="Flow_25" sourceRef="Event_1" targetRef="Activity_7" />
      <bpmn:sequenceFlow id="Flow_26" sourceRef="Activity_10" targetRef="Event_2" />
    </bpmn:subProcess>
    <bpmn:userTask id="Activity_11" name="Составить дефектную ведомость">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_2" name="Повреждение локализовано?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_3" name="Параллельные работы">
