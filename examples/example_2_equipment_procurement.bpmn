  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Закупка силового трансформатора 110/10 кВ с проверкой СБ и тендерным комитетом" processRef="Process_Root" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Root" name="Закупка силового трансформатора 110/10 кВ с проверкой СБ и тендерным комитетом" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Root">
      <bpmn:lane id="Lane_1" name="Технический департамент">
        <bpmn:flowNodeRef>Activity_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RootStart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Закупочная служба">
        <bpmn:flowNodeRef>Activity_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Служба безопасности">
        <bpmn:flowNodeRef>Activity_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RootEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Тендерный комитет">
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Юридическая служба">
        <bpmn:flowNodeRef>Activity_10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_1" name="Сформировать потребность и техническое задание на силовой трансформатор 110/10 кВ">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_2" name="Обосновать начальную максимальную цену и подготовить заявку на закупку">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_3" name="Проверить комплектность заявки и выбрать способ закупки">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Заявка оформлена полностью?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_4" name="Разработать закупочную документацию">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_5" name="Публиковать извещение на электронной площадке">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_6" name="Принять и зарегистрировать заявки участников">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_7" name="Провести первичный отбор участников по формальным признакам">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_8" name="Благонадёжность, аффилированность, санкционные риски">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_2" name="Проверка пройдена?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_3" name="Параллельные работы">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_4" name="Работы завершены">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Activity_9" name="Оценить и сопоставлять предложения участников">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_10" name="Провести экспертизу проекта договора и условий поставки">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_11" name="Определить победителя и утверждать протокол">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_5" name="Победитель определён?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_12" name="Заключить договор поставки с победителем">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_13" name="Организовать приёмку трансформатора и входной контроль">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Event_RootStart" name="Старт процесса">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_RootEnd" name="Процесс завершён">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
